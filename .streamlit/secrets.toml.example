# Copy this file to .streamlit/secrets.toml and fill in the real values.
# secrets.toml is listed in .gitignore, so it never gets pushed to GitHub.
#
# Leave a section out to use local mode for that part:
#   - no [database] -> data is saved in pawpal_local.db on your computer
#   - no [auth]     -> no sign-in; everyone shares one local user

[database]
# From Neon: Dashboard -> Connect -> connection string
url = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

[auth]
# On your computer:
redirect_uri = "http://localhost:8501/oauth2callback"
# When deployed, use your app's address instead, e.g.
# redirect_uri = "https://your-app-name.streamlit.app/oauth2callback"

# A long random string. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

# From Google Cloud Console -> APIs & Services -> Credentials
client_id = "REPLACE_ME.apps.googleusercontent.com"
client_secret = "REPLACE_ME"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
